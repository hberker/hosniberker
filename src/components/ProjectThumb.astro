---
interface Props {
  kind: 'search' | 'os' | 'quantum' | 'cnote';
}

const { kind } = Astro.props;
---

<div class="thumb" aria-hidden="true">
  {
    kind === 'search' && (
      <svg viewBox="0 0 96 72" fill="none">
        <circle cx="30" cy="30" r="4" fill="currentColor" opacity=".9" />
        <circle cx="62" cy="20" r="4" fill="currentColor" opacity=".55" />
        <circle cx="70" cy="48" r="4" fill="currentColor" opacity=".7" />
        <circle cx="40" cy="54" r="4" fill="currentColor" opacity=".45" />
        <path
          d="M30 30L62 20M62 20L70 48M70 48L40 54M40 54L30 30M30 30L70 48"
          stroke="currentColor"
          stroke-width="1.2"
          opacity=".35"
        />
      </svg>
    )
  }
  {
    kind === 'os' && (
      <svg viewBox="0 0 96 72" fill="none">
        <rect x="22" y="14" width="52" height="10" rx="2" stroke="currentColor" stroke-width="1.4" opacity=".9" />
        <rect x="22" y="30" width="34" height="10" rx="2" stroke="currentColor" stroke-width="1.4" opacity=".6" />
        <rect x="62" y="30" width="12" height="10" rx="2" fill="currentColor" opacity=".5" />
        <rect x="22" y="46" width="52" height="10" rx="2" stroke="currentColor" stroke-width="1.4" opacity=".35" />
      </svg>
    )
  }
  {
    kind === 'quantum' && (
      <svg viewBox="0 0 96 72" fill="none">
        <path d="M18 24h60M18 48h60" stroke="currentColor" stroke-width="1.2" opacity=".4" />
        <rect x="30" y="17" width="14" height="14" rx="2" stroke="currentColor" stroke-width="1.4" opacity=".9" />
        <circle cx="65" cy="24" r="5.5" stroke="currentColor" stroke-width="1.4" opacity=".7" />
        <path d="M65 18.5v11" stroke="currentColor" stroke-width="1.4" opacity=".7" />
        <rect x="58" y="41" width="14" height="14" rx="2" stroke="currentColor" stroke-width="1.4" opacity=".55" />
        <path d="M37 31v10" stroke="currentColor" stroke-width="1.2" opacity=".4" />
        <circle cx="37" cy="48" r="2.5" fill="currentColor" opacity=".6" />
      </svg>
    )
  }
  {
    kind === 'cnote' && (
      <svg viewBox="0 0 96 72" fill="none">
        <path
          d="M16 36c5-14 9-14 14 0s9 14 14 0 9-14 14 0 9 14 14 0"
          stroke="currentColor"
          stroke-width="1.5"
          opacity=".75"
        />
        <rect x="60" y="14" width="16" height="16" rx="3" stroke="currentColor" stroke-width="1.4" opacity=".45" />
        <circle cx="24" cy="56" r="4" fill="currentColor" opacity=".55" />
        <path d="M28 56V42l8 2" stroke="currentColor" stroke-width="1.4" opacity=".55" />
      </svg>
    )
  }
</div>

<style>
  .thumb {
    width: 108px;
    height: 78px;
    flex-shrink: 0;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--thumb-ink);
    background: var(--thumb-bg);
    border: 1px solid var(--thumb-border);
  }

  .thumb svg {
    width: 92px;
    height: 68px;
  }

  @media (max-width: 640px) {
    .thumb {
      width: 88px;
      height: 64px;
    }

    .thumb svg {
      width: 76px;
      height: 56px;
    }
  }
</style>
