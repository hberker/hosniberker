---
import Base from '../layouts/Base.astro';
import TopNav from '../components/TopNav.astro';
import { withBase } from '../lib/url';
---

<Base title="Not found" description="Page not found.">
  <TopNav />
  <main id="main" class="page">
    <p class="mono-meta">404</p>
    <h1>There's nothing at this address.</h1>
    <p class="lede">
      The page may have moved, or the link was mistyped.
      <a class="ilink" href={withBase('/')}>Head back home</a>.
    </p>
  </main>
</Base>

<style>
  .page {
    max-width: 720px;
    margin: 0 auto;
    padding: 6rem 3.5rem;
  }

  h1 {
    margin-top: 1rem;
    font-size: 1.75rem;
    font-weight: 640;
    letter-spacing: -0.025em;
  }

  .lede {
    margin-top: 0.8rem;
    color: var(--muted);
  }

  @media (max-width: 640px) {
    .page {
      padding: 4rem 1.4rem;
    }
  }
</style>
