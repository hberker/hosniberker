---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import TopNav from '../../components/TopNav.astro';
import { withBase } from '../../lib/url';

const posts = (await getCollection('writing', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const fmt = new Intl.DateTimeFormat('en-US', { month: 'short', year: 'numeric' });
---

<Base title="Writing" description="Essays and notes by Hosni Berker.">
  <TopNav current="writing" />
  <main id="main" class="page">
    <h1>Writing</h1>
    <p class="lede">Occasional notes on systems, performance work, and whatever I’m learning.</p>

    <ol class="posts">
      {
        posts.map((post) => (
          <li>
            <a class="post-row" href={withBase(`/writing/${post.id}/`)}>
              <span class="post-title">{post.data.title}</span>
              <span class="post-desc">{post.data.description}</span>
              <time class="mono-meta" datetime={post.data.date.toISOString().slice(0, 10)}>
                {fmt.format(post.data.date)}
              </time>
            </a>
          </li>
        ))
      }
    </ol>
  </main>
</Base>

<style>
  .page {
    max-width: 720px;
    margin: 0 auto;
    padding: 4.5rem 3.5rem 6rem;
  }

  h1 {
    font-size: 1.75rem;
    font-weight: 640;
    letter-spacing: -0.025em;
  }

  .lede {
    margin-top: 0.6rem;
    color: var(--muted);
    max-width: 48ch;
  }

  .posts {
    margin-top: 3rem;
    display: flex;
    flex-direction: column;
  }

  .posts li + li {
    border-top: 1px solid var(--border);
  }

  .post-row {
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-areas:
      'title date'
      'desc  date';
    column-gap: 1.5rem;
    row-gap: 0.25rem;
    padding: 1.4rem 0.25rem;
    border-radius: 6px;
    transition: color 0.15s var(--ease);
  }

  .post-title {
    grid-area: title;
    font-weight: 600;
    letter-spacing: -0.011em;
    transition: color 0.15s var(--ease);
  }

  .post-row:hover .post-title {
    color: var(--accent);
  }

  .post-desc {
    grid-area: desc;
    color: var(--muted);
    font-size: var(--text-card);
    max-width: 52ch;
  }

  .post-row time {
    grid-area: date;
    align-self: start;
    padding-top: 0.3rem;
  }

  @media (max-width: 640px) {
    .page {
      padding: 3rem 1.4rem 4rem;
    }

    .post-row {
      grid-template-columns: 1fr;
      grid-template-areas: 'date' 'title' 'desc';
    }

    .post-row time {
      padding-top: 0;
    }
  }
</style>
