---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import TopNav from '../../components/TopNav.astro';
import { withBase } from '../../lib/url';

export async function getStaticPaths() {
  const posts = await getCollection('writing', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const fmt = new Intl.DateTimeFormat('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
---

<Base title={post.data.title} description={post.data.description}>
  <TopNav current="writing" />
  <main id="main" class="page">
    <article>
      <header>
        <p class="mono-meta">
          <a class="back" href={withBase('/writing/')}>&larr; Writing</a>
        </p>
        <h1>{post.data.title}</h1>
        <time class="mono-meta" datetime={post.data.date.toISOString().slice(0, 10)}>
          {fmt.format(post.data.date)}
        </time>
      </header>
      <div class="prose">
        <Content />
      </div>
    </article>
  </main>
</Base>

<style>
  .page {
    max-width: 720px;
    margin: 0 auto;
    padding: 4.5rem 3.5rem 6rem;
  }

  .back {
    color: var(--faint);
    transition: color 0.15s var(--ease);
  }

  .back:hover {
    color: var(--accent);
  }

  h1 {
    margin-top: 1.4rem;
    font-size: 1.75rem;
    font-weight: 640;
    letter-spacing: -0.025em;
    line-height: 1.2;
  }

  header time {
    display: block;
    margin-top: 0.7rem;
  }

  .prose {
    margin-top: 2.5rem;
    color: var(--body);
  }

  .prose :global(h2) {
    margin: 2.2rem 0 0.8rem;
    font-size: 1.15rem;
    font-weight: 620;
    letter-spacing: -0.015em;
    color: var(--ink);
  }

  .prose :global(h3) {
    margin: 1.8rem 0 0.6rem;
    font-size: 1rem;
    font-weight: 620;
    color: var(--ink);
  }

  .prose :global(p) {
    margin: 0 0 1rem;
  }

  .prose :global(ul),
  .prose :global(ol) {
    margin: 0 0 1rem;
    padding-left: 1.2rem;
  }

  .prose :global(ul) {
    list-style: disc;
  }

  .prose :global(ol) {
    list-style: decimal;
  }

  .prose :global(li) {
    margin-bottom: 0.35rem;
  }

  .prose :global(a) {
    color: var(--accent);
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--accent) 35%, transparent);
    text-underline-offset: 3px;
    transition: text-decoration-color 0.15s var(--ease);
  }

  .prose :global(a:hover) {
    text-decoration-color: var(--accent);
  }

  .prose :global(code) {
    font-family: var(--mono);
    font-size: 0.85em;
    background: var(--tag-bg);
    padding: 0.12em 0.4em;
    border-radius: 5px;
  }

  .prose :global(pre) {
    margin: 0 0 1rem;
    padding: 1rem 1.2rem;
    border-radius: 10px;
    border: 1px solid var(--border);
    overflow-x: auto;
    font-size: 0.85rem;
  }

  .prose :global(pre code) {
    background: none;
    padding: 0;
  }

  .prose :global(blockquote) {
    margin: 0 0 1rem;
    padding-left: 1rem;
    border-left: 2px solid var(--border-strong);
    color: var(--muted);
  }

  .prose :global(strong) {
    color: var(--ink);
    font-weight: 620;
  }

  @media (max-width: 640px) {
    .page {
      padding: 3rem 1.4rem 4rem;
    }
  }
</style>
