---
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import TopNav from '../components/TopNav.astro';
import Footer from '../components/Footer.astro';

// Every image in src/photos/ becomes a gallery entry automatically.
// See src/photos/README.md for the drop-in workflow.
const modules = import.meta.glob<{ default: ImageMetadata }>(
  '../photos/*.{jpg,jpeg,png,webp,avif}',
  { eager: true }
);

function labelFrom(path: string): string {
  const name = path.split('/').pop()!.replace(/\.\w+$/, '');
  const cleaned = name.replace(/^placeholder-/, '').replace(/^\d+[-_]?/, '');
  return cleaned.replace(/[-_]+/g, ' ').trim() || 'untitled';
}

const photos = await Promise.all(
  Object.entries(modules)
    .sort(([a], [b]) => a.localeCompare(b))
    .map(async ([path, mod], index) => {
      const thumb = await getImage({
        src: mod.default,
        widths: [280, 420, 560],
        sizes: '(max-width: 640px) 46vw, 270px',
        format: 'webp',
      });
      const full = await getImage({ src: mod.default, width: 1600, format: 'webp' });
      return { label: labelFrom(path), thumb, full: full.src, index };
    })
);

// Contact-sheet strips of four — a shorter cut at the end is authentic.
const strips: (typeof photos)[] = [];
for (let i = 0; i < photos.length; i += 4) strips.push(photos.slice(i, i + 4));

const frameNo = (i: number) => String(i + 1).padStart(2, '0');
---

<Base
  title="Film"
  description="A photography gallery by Hosni Berker — negatives on the light table. Currently holding generated placeholder frames."
>
  <TopNav current="film" />
  <main id="main" class="page">
    <h1>Film</h1>
    <p class="lede">
      Frames from the other hobby, laid out as cut negatives — hover to develop one, click to put
      it on the light table. These are generated placeholders for now; real rolls are being
      scanned.
    </p>

    <ol class="strips" aria-label="Film strips">
      {
        strips.map((strip, s) => (
          <li class="strip">
            <span class="edge-label" aria-hidden="true">
              HB&nbsp;135&nbsp;·&nbsp;ROLL&nbsp;{String(s + 1).padStart(2, '0')}
            </span>
            <ul class="frames">
              {strip.map(({ label, thumb, index }) => (
                <li class="frame">
                  <button
                    class="shot"
                    type="button"
                    data-index={index}
                    aria-label={`View “${label}” on the light table`}
                  >
                    <img
                      src={thumb.src}
                      srcset={thumb.srcSet.attribute}
                      sizes={thumb.attributes.sizes}
                      width={thumb.attributes.width}
                      height={thumb.attributes.height}
                      alt={label}
                      loading={index < 4 ? 'eager' : 'lazy'}
                      decoding="async"
                    />
                  </button>
                  <span class="frame-no" aria-hidden="true">
                    {frameNo(index)}A
                  </span>
                </li>
              ))}
            </ul>
          </li>
        ))
      }
    </ol>

    <Footer />
  </main>

  <dialog class="lightbox" aria-label="Light table">
    <div class="table">
      <div class="glow" aria-hidden="true"></div>
      <ul class="tape">
        {
          photos.map(({ label, full, index }) => (
            <li class="cell">
              <button
                class="cell-btn"
                type="button"
                data-index={index}
                aria-label={`Go to frame ${frameNo(index)} — ${label}`}
              >
                <img data-src={full} alt={label} decoding="async" />
              </button>
              <span class="cell-no" aria-hidden="true">{frameNo(index)}A</span>
            </li>
          ))
        }
      </ul>
    </div>
    <p class="caption mono-meta" aria-live="polite"></p>
    <button class="lb-btn lb-close" type="button" aria-label="Close light table">&times;</button>
    <button class="lb-btn lb-prev" type="button" aria-label="Previous frame">&larr;</button>
    <button class="lb-btn lb-next" type="button" aria-label="Next frame">&rarr;</button>
    <button class="lb-btn lb-play" type="button" aria-label="Pause slideshow" aria-pressed="true">
      <span class="icon-pause" aria-hidden="true"></span>
      <span class="icon-play" aria-hidden="true"></span>
    </button>
  </dialog>
</Base>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('.lightbox')!;
  const tape = dialog.querySelector<HTMLUListElement>('.tape')!;
  const cells = [...dialog.querySelectorAll<HTMLLIElement>('.cell')];
  const caption = dialog.querySelector('.caption')!;
  const playBtn = dialog.querySelector<HTMLButtonElement>('.lb-play')!;
  const shots = [...document.querySelectorAll<HTMLButtonElement>('.shot')];
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  const DWELL_MS = 5000;
  let current = 0;
  let timer: number | undefined;
  let playing = false;

  function loadCell(index: number) {
    const img = cells[index]?.querySelector('img');
    if (img && !img.src && img.dataset.src) img.src = img.dataset.src;
  }

  function show(index: number) {
    current = (index + cells.length) % cells.length;
    tape.style.setProperty('--i', String(current));
    for (const [i, cell] of cells.entries()) {
      cell.classList.toggle('current', i === current);
    }
    // the frame on the table and its neighbours load; the rest wait
    loadCell(current);
    loadCell((current + 1) % cells.length);
    loadCell((current - 1 + cells.length) % cells.length);
    const label = cells[current].querySelector('img')!.alt;
    caption.textContent = `${String(current + 1).padStart(2, '0')} / ${String(cells.length).padStart(2, '0')} — ${label}`;
  }

  function stopAuto() {
    if (timer !== undefined) window.clearInterval(timer);
    timer = undefined;
    playing = false;
    playBtn.setAttribute('aria-pressed', 'false');
    playBtn.setAttribute('aria-label', 'Play slideshow');
    dialog.classList.remove('playing');
  }

  function startAuto() {
    if (timer !== undefined) window.clearInterval(timer);
    timer = window.setInterval(() => show(current + 1), DWELL_MS);
    playing = true;
    playBtn.setAttribute('aria-pressed', 'true');
    playBtn.setAttribute('aria-label', 'Pause slideshow');
    dialog.classList.add('playing');
  }

  /** manual navigation keeps the slideshow running but restarts its clock */
  function nudge(index: number) {
    show(index);
    if (playing) startAuto();
  }

  for (const shot of shots) {
    shot.addEventListener('click', () => {
      show(Number(shot.dataset.index));
      dialog.showModal();
      if (reducedMotion.matches) stopAuto();
      else startAuto();
    });
  }

  for (const btn of dialog.querySelectorAll<HTMLButtonElement>('.cell-btn')) {
    btn.addEventListener('click', () => nudge(Number(btn.dataset.index)));
  }

  playBtn.addEventListener('click', () => (playing ? stopAuto() : startAuto()));
  dialog.querySelector('.lb-close')!.addEventListener('click', () => dialog.close());
  dialog.querySelector('.lb-prev')!.addEventListener('click', () => nudge(current - 1));
  dialog.querySelector('.lb-next')!.addEventListener('click', () => nudge(current + 1));

  dialog.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowLeft') nudge(current - 1);
    if (e.key === 'ArrowRight') nudge(current + 1);
  });

  // click on the backdrop (outside the tape/controls) closes
  dialog.addEventListener('click', (e) => {
    if (e.target === dialog || e.target === dialog.querySelector('.table')) dialog.close();
  });

  // return focus to the negative that opened the table
  dialog.addEventListener('close', () => {
    stopAuto();
    shots[current]?.focus();
  });
</script>

<style>
  .page {
    max-width: 1140px;
    margin: 0 auto;
    padding: 4.5rem 3.5rem 6rem;
  }

  h1 {
    font-family: var(--display);
    font-size: 1.75rem;
    font-weight: 640;
    letter-spacing: -0.025em;
  }

  .lede {
    margin-top: 0.6rem;
    color: var(--muted);
    max-width: 56ch;
  }

  /* ------------------------------------------------------------- strips */
  .strips {
    margin-top: 3rem;
    margin-bottom: 4rem;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  /* a cut strip of negatives: film base with sprocket rows top and bottom */
  .strip {
    position: relative;
    background: #101013;
    border-radius: 4px;
    padding: 1.6rem 1rem 1.9rem;
    box-shadow: inset 0 1px 0 0 rgba(161, 161, 170, 0.07);
  }

  .strip::before,
  .strip::after {
    content: '';
    position: absolute;
    left: 1rem;
    right: 1rem;
    height: 9px;
    background: repeating-linear-gradient(90deg, var(--bg) 0 13px, transparent 13px 29px);
  }

  .strip::before {
    top: 8px;
  }

  .strip::after {
    bottom: 8px;
  }

  .edge-label {
    position: absolute;
    top: 1.05rem;
    right: 1.4rem;
    z-index: 1;
    font-family: var(--mono);
    font-size: 0.5625rem;
    letter-spacing: 0.22em;
    color: #b98a44;
  }

  .frames {
    display: flex;
    gap: 0.7rem;
  }

  /* fixed quarter-width frames so a short cut at the end keeps the same
     frame size as a full strip */
  .frame {
    flex: 0 0 calc((100% - 2.1rem) / 4);
    min-width: 0;
    position: relative;
  }

  .shot {
    display: block;
    width: 100%;
    padding: 0;
    border-radius: 2px;
    overflow: hidden;
    background: #060607;
  }

  .shot img {
    width: 100%;
    height: auto; /* beat the height attribute so aspect-ratio can apply */
    aspect-ratio: 3 / 2;
    object-fit: cover;
    /* undeveloped frame: inverted, with the orange mask of colour negative film */
    filter: invert(1) hue-rotate(180deg) sepia(0.32) saturate(1.35) brightness(0.9);
    transition:
      filter 0.4s var(--ease),
      transform 0.4s var(--ease);
  }

  /* hover develops the negative into a positive */
  @media (hover: hover) {
    .shot:hover img {
      filter: none;
    }
  }

  .shot:focus-visible img {
    filter: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    .shot:hover img {
      transform: scale(1.02);
    }
  }

  .frame-no {
    position: absolute;
    left: 2px;
    bottom: -1.45rem;
    font-family: var(--mono);
    font-size: 0.5625rem;
    letter-spacing: 0.18em;
    color: #b98a44;
  }

  /* --------------------------------------------------------- light table */
  .lightbox {
    margin: 0;
    border: none;
    padding: 0;
    background: transparent;
    max-width: 100vw;
    max-height: 100vh;
    width: 100vw;
    height: 100vh;
  }

  :global(body:has(.lightbox[open])) {
    overflow: hidden;
  }

  .lightbox::backdrop {
    background: rgb(6 6 7 / 0.96);
  }

  .table {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  /* the glowing panel the current frame sits over */
  .glow {
    position: absolute;
    left: 50%;
    top: 50%;
    width: min(88vw, 1160px);
    height: min(72vh, 820px);
    transform: translate(-50%, -50%);
    background: radial-gradient(
      closest-side,
      rgba(250, 250, 250, 0.14),
      rgba(250, 250, 250, 0.04) 55%,
      transparent
    );
    pointer-events: none;
  }

  /* the tape itself: one long film base the frames sit on, with sprocket
     rows punched out of the top and bottom via layered gradients */
  .tape {
    --cell-w: min(76vw, 1000px);
    --gap: 1.1rem;
    flex: none;
    width: max-content;
    display: flex;
    gap: var(--gap);
    align-items: center;
    padding: 2.4rem var(--gap) 2.6rem;
    background:
      repeating-linear-gradient(90deg, rgb(6 6 7 / 0.96) 0 15px, transparent 15px 33px) left 0.5rem
        top 0.7rem / 100% 10px no-repeat,
      repeating-linear-gradient(90deg, rgb(6 6 7 / 0.96) 0 15px, transparent 15px 33px) left 0.5rem
        bottom 0.7rem / 100% 10px no-repeat,
      #101013;
    transform: translateX(
      calc(50vw - (var(--i, 0) + 0.5) * (var(--cell-w) + var(--gap)) - var(--gap) / 2)
    );
    transition: transform 0.55s var(--ease);
    will-change: transform;
  }

  .cell {
    flex: 0 0 var(--cell-w);
    position: relative;
    opacity: 0.28;
    transition: opacity 0.45s var(--ease);
  }

  .cell.current {
    opacity: 1;
  }

  .cell-btn {
    display: block;
    width: 100%;
    padding: 0;
    border-radius: 3px;
    overflow: hidden;
    background: #060607;
  }

  .cell img {
    width: 100%;
    height: min(62vh, 700px);
    object-fit: contain;
    background: #060607;
  }

  .cell-no {
    position: absolute;
    left: 4px;
    bottom: -1.9rem;
    font-family: var(--mono);
    font-size: 0.625rem;
    letter-spacing: 0.2em;
    color: #b98a44;
  }

  .caption {
    position: fixed;
    left: 50%;
    bottom: 1.5rem;
    transform: translateX(-50%);
    color: #d4d4d8;
    text-transform: none;
    letter-spacing: 0.08em;
    pointer-events: none;
  }

  /* ------------------------------------------------------------ controls */
  .lb-btn {
    position: fixed;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 999px;
    background: rgb(250 250 250 / 0.12);
    color: #fafafa;
    font-size: 1.15rem;
    line-height: 1;
    transition: background 0.15s var(--ease);
  }

  .lb-btn:hover {
    background: rgb(250 250 250 / 0.25);
  }

  .lb-close {
    top: 1.25rem;
    right: 1.25rem;
  }

  .lb-play {
    top: 1.25rem;
    right: 4.75rem;
  }

  .lb-prev {
    left: 1.25rem;
    top: 50%;
    translate: 0 -50%;
  }

  .lb-next {
    right: 1.25rem;
    top: 50%;
    translate: 0 -50%;
  }

  /* play/pause glyphs drawn in CSS so they inherit color cleanly */
  .icon-pause,
  .icon-play {
    display: none;
  }

  .lightbox.playing .icon-pause {
    display: block;
    width: 11px;
    height: 12px;
    border-left: 3.5px solid currentColor;
    border-right: 3.5px solid currentColor;
  }

  .lightbox:not(.playing) .icon-play {
    display: block;
    width: 0;
    height: 0;
    margin-left: 2px;
    border-top: 6px solid transparent;
    border-bottom: 6px solid transparent;
    border-left: 10px solid currentColor;
  }

  /* ---------------------------------------------------------- responsive */
  @media (max-width: 640px) {
    .page {
      padding: 3rem 1.4rem 4rem;
    }

    .strips {
      margin-top: 2rem;
      margin-bottom: 3rem;
      gap: 1.5rem;
    }

    .strip {
      padding: 1.35rem 0.7rem 1.6rem;
    }

    .frames {
      overflow-x: auto;
      scrollbar-width: none;
      gap: 0.5rem;
    }

    .frames::-webkit-scrollbar {
      display: none;
    }

    .frame {
      flex: 0 0 46vw;
    }

    .tape {
      --cell-w: 88vw;
      --gap: 0.7rem;
    }

    /* the frame owns the top of the screen; everything else stacks
       centered underneath it */
    .table {
      align-items: flex-start;
    }

    .glow {
      top: calc(2.4rem + 28vh);
      height: min(64vh, 820px);
    }

    .cell img {
      height: min(56vh, 700px);
    }

    .caption {
      bottom: auto;
      top: calc(56vh + 6.6rem);
    }

    .lb-btn {
      top: calc(56vh + 9rem);
      bottom: auto;
      right: auto;
      translate: none;
    }

    .lb-prev {
      left: calc(50% - 109px);
    }

    .lb-play {
      left: calc(50% - 51px);
    }

    .lb-next {
      left: calc(50% + 7px);
    }

    .lb-close {
      left: calc(50% + 65px);
    }
  }
</style>
