---
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import TopNav from '../components/TopNav.astro';

// Every image in src/photos/ becomes a gallery entry automatically.
// See src/photos/README.md for the drop-in workflow.
const modules = import.meta.glob<{ default: ImageMetadata }>(
  '../photos/*.{jpg,jpeg,png,webp,avif}',
  { eager: true }
);

function labelFrom(path: string): string {
  const name = path.split('/').pop()!.replace(/\.\w+$/, '');
  const cleaned = name.replace(/^placeholder-/, '').replace(/^\d+[-_]?/, '');
  return cleaned.replace(/[-_]+/g, ' ').trim() || 'untitled';
}

const photos = await Promise.all(
  Object.entries(modules)
    .sort(([a], [b]) => a.localeCompare(b))
    .map(async ([path, mod], index) => {
      const thumb = await getImage({
        src: mod.default,
        widths: [420, 640, 900],
        sizes: '(max-width: 640px) 94vw, (max-width: 1100px) 46vw, 30vw',
        format: 'webp',
      });
      const full = await getImage({ src: mod.default, width: 1800, format: 'webp' });
      return { label: labelFrom(path), thumb, full: full.src, index };
    })
);
---

<Base
  title="Film"
  description="A photography gallery by Hosni Berker — currently holding generated placeholder frames."
>
  <TopNav current="film" />
  <main id="main" class="page">
    <h1>Film</h1>
    <p class="lede">
      Frames from the other hobby. These are generated placeholders for now — real rolls are being
      scanned.
    </p>

    <ul class="grid">
      {
        photos.map(({ label, thumb, full, index }) => (
          <li>
            <button
              class="shot"
              type="button"
              data-full={full}
              data-label={label}
              data-index={index}
              aria-label={`View “${label}” larger`}
            >
              <img
                src={thumb.src}
                srcset={thumb.srcSet.attribute}
                sizes={thumb.attributes.sizes}
                width={thumb.attributes.width}
                height={thumb.attributes.height}
                alt={label}
                loading={index < 4 ? 'eager' : 'lazy'}
                decoding="async"
              />
            </button>
          </li>
        ))
      }
    </ul>
  </main>

  <dialog class="lightbox" aria-label="Photo viewer">
    <figure>
      <img alt="" />
      <figcaption class="mono-meta"></figcaption>
    </figure>
    <button class="lb-btn lb-close" type="button" aria-label="Close viewer">&times;</button>
    <button class="lb-btn lb-prev" type="button" aria-label="Previous photo">&larr;</button>
    <button class="lb-btn lb-next" type="button" aria-label="Next photo">&rarr;</button>
  </dialog>
</Base>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('.lightbox')!;
  const img = dialog.querySelector('img')!;
  const caption = dialog.querySelector('figcaption')!;
  const shots = [...document.querySelectorAll<HTMLButtonElement>('.shot')];
  let current = 0;

  function show(index: number) {
    current = (index + shots.length) % shots.length;
    const shot = shots[current];
    img.src = shot.dataset.full!;
    img.alt = shot.dataset.label!;
    caption.textContent = `${String(current + 1).padStart(2, '0')} / ${String(shots.length).padStart(2, '0')} — ${shot.dataset.label}`;
  }

  for (const shot of shots) {
    shot.addEventListener('click', () => {
      show(Number(shot.dataset.index));
      dialog.showModal();
    });
  }

  dialog.querySelector('.lb-close')!.addEventListener('click', () => dialog.close());
  dialog.querySelector('.lb-prev')!.addEventListener('click', () => show(current - 1));
  dialog.querySelector('.lb-next')!.addEventListener('click', () => show(current + 1));

  dialog.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowLeft') show(current - 1);
    if (e.key === 'ArrowRight') show(current + 1);
  });

  // click on the backdrop (outside the figure) closes
  dialog.addEventListener('click', (e) => {
    if (e.target === dialog) dialog.close();
  });

  // return focus to the thumbnail that opened the viewer
  dialog.addEventListener('close', () => shots[current]?.focus());
</script>

<style>
  .page {
    max-width: 1240px;
    margin: 0 auto;
    padding: 4.5rem 3.5rem 6rem;
  }

  h1 {
    font-size: 1.75rem;
    font-weight: 640;
    letter-spacing: -0.025em;
  }

  .lede {
    margin-top: 0.6rem;
    color: var(--muted);
    max-width: 52ch;
  }

  .grid {
    margin-top: 3rem;
    columns: 3 300px;
    column-gap: 1rem;
  }

  .grid li {
    break-inside: avoid;
    margin-bottom: 1rem;
  }

  .shot {
    display: block;
    width: 100%;
    padding: 0;
    border-radius: 10px;
    overflow: hidden;
    border: 1px solid var(--border);
    background: var(--surface);
    transition:
      border-color 0.2s var(--ease),
      box-shadow 0.2s var(--ease);
  }

  .shot img {
    width: 100%;
    height: auto;
    transition: transform 0.35s var(--ease);
  }

  .shot:hover {
    border-color: var(--card-hover-border);
    box-shadow: 0 1px 3px rgb(24 24 27 / 0.06);
  }

  @media (prefers-reduced-motion: no-preference) {
    .shot:hover img {
      transform: scale(1.015);
    }
  }

  /* ------------------------------------------------------------ lightbox */
  .lightbox {
    /* the global reset zeroes margins, so restore the UA's auto-centering */
    margin: auto;
    border: none;
    padding: 0;
    background: transparent;
    max-width: 100vw;
    max-height: 100vh;
  }

  :global(body:has(.lightbox[open])) {
    overflow: hidden;
  }

  .lightbox::backdrop {
    background: rgb(24 24 27 / 0.88);
  }

  .lightbox figure {
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.8rem;
  }

  .lightbox img {
    max-width: min(92vw, 1200px);
    max-height: 84vh;
    width: auto;
    height: auto;
    border-radius: 6px;
  }

  .lightbox figcaption {
    color: #d4d4d8;
    text-transform: none;
    letter-spacing: 0.08em;
  }

  .lb-btn {
    position: fixed;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 999px;
    background: rgb(250 250 250 / 0.12);
    color: #fafafa;
    font-size: 1.15rem;
    line-height: 1;
    transition: background 0.15s var(--ease);
  }

  .lb-btn:hover {
    background: rgb(250 250 250 / 0.25);
  }

  .lb-close {
    top: 1.25rem;
    right: 1.25rem;
  }

  .lb-prev {
    left: 1.25rem;
    top: 50%;
    translate: 0 -50%;
  }

  .lb-next {
    right: 1.25rem;
    top: 50%;
    translate: 0 -50%;
  }

  @media (max-width: 640px) {
    .page {
      padding: 3rem 1.4rem 4rem;
    }

    .grid {
      margin-top: 2rem;
    }

    .lb-prev,
    .lb-next {
      top: auto;
      bottom: 1.25rem;
      translate: none;
    }

    .lb-prev {
      left: 1.25rem;
    }

    .lb-next {
      right: 1.25rem;
    }
  }
</style>
